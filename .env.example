# Servidor
PORT=3001
NODE_ENV=development

# Google OAuth
GOOGLE_CLIENT_ID=seu_client_id_aqui
GOOGLE_CLIENT_SECRET=seu_client_secret_aqui
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# IDs do Drive (obtidos do arquivo IDs do Google.md)
ROOT_FOLDER_ID=id_da_pasta_raiz
PROGRESS_SHEET_ID=id_da_planilha_progresso
BMC_TEMPLATE_DOC_ID=id_do_template_docs
TUTORIAL_DOC_ID=id_do_tutorial_docs
DRIVE_SKILL_FILE_ID=id_da_skill_consultor

# Configurações de E-mail
ADMIN_EMAIL=admin@pampatec.org
GMAIL_USER=seu_email@gmail.com

# Cookie Key
COOKIE_KEY=seu_cookie_secret_key
